# DHSGSU Campus Assistant Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Server-side Gemini API key (NEVER expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Connection URI (NEVER expose to frontend)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dhsgsu-campus-assistant?retryWrites=true&w=majority
MONGODB_DB_NAME=dhsgsu-campus-assistant
